{
  "name": "yae-modernize-tailwind",
  "version": "1.1.2",
  "description": "A powerful CLI tool to automate migration of Tailwind CSS classes to newer, more efficient conventions",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=23.5.0"
  },
  "main": "dist/index.js",
  "bin": {
    "yae-modernize-tailwind": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "format": "prettier \"src/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" --check",
    "test": "vitest",
    "test:run": "vitest --run",
    "coverage": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "release:check": "npm run lint:check && npm run format:check && npm run test:run && npm run build"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "migration",
    "cli",
    "modernize",
    "refactor",
    "utility-classes",
    "automation",
    "frontend",
    "web-development"
  ],
  "author": "Azula9713",
  "license": "MIT",
  "homepage": "https://github.com/Yae-Tools/yae-modernize-tailwind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yae-Tools/yae-modernize-tailwind.git"
  },
  "bugs": {
    "url": "https://github.com/Yae-Tools/yae-modernize-tailwind/issues"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "glob": "^13.0.6",
    "inquirer": "^13.4.2",
    "ora": "^9.4.0",
    "simple-git": "^3.36.0",
    "uuid": "^14.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.2",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rollup": "^4.60.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
